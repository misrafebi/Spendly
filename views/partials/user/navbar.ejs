<!DOCTYPE html>
<html>

<head>
    <link rel="stylesheet" href="../../public/user/style.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Segoe UI', Arial, sans-serif;
  background: #eef1f5;
  width: 1200px;
}
.frame {
  width: 1200px;
  min-height: 750px;
  background: #f7f8fa;
  position: relative;
}
.topbar {
  height: 64px;
  background: #2d3e50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28px;
  color: #fff;
}
.topbar .logo {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 0.5px;
}
.topbar .logo span { color: #6fcf97; }
.topbar .nav-right {
  display: flex;
  gap: 22px;
  font-size: 14px;
  color: #cbd5e0;
}
    </style>
</head>

<body>
    <div class="frame">
        <div class="topbar">
            <div class="logo">Penny<span>.</span></div>
            <div class="nav-right"><span>Jane Doe</span><span>&#9660;</span></div>
        </div>