<!DOCTYPE html>
<html>

<head>
    <link rel="stylesheet" href="../../public/user/style.css">
</head>

<body>
    <div class="frame" style="display:flex;align-items:center;justify-content:center;">
        <div class="wf-box" style="width:420px;padding:32px 34px;border-radius:8px;position:relative;">
            <div style="text-align:center;margin-bottom:22px;">
                <div style="font-size:22px;font-weight:700;color:#2d3e50;">Penny<span style="color:#6fcf97;">.</span>
                </div>
                <div style="font-size:12.5px;color:#8a94a3;margin-top:4px;">Create your account</div>
            </div>
            <div class="form-group">
                <span class="form-label">Full Name</span>
                <div class="form-input">Jane Doe</div>
            </div>
            <div class="form-group">
                <span class="form-label">Email</span>
                <div class="form-input">you@example.com</div>
            </div>
            <div class="form-group">
                <span class="form-label">Password</span>
                <div class="form-input">••••••••</div>
            </div>
            <div class="form-group">
                <span class="form-label">Confirm Password</span>
                <div class="form-input">••••••••</div>
            </div>
            <div class="btn btn-primary" style="width:100%;">Create Account</div>
            <div style="text-align:center;font-size:12.5px;color:#8a94a3;margin-top:14px;">
                Already have an account? <span style="color:#2d6cdf;font-weight:600;">Log In</span>
            </div>
        </div>

    </div>
</body>

</html>