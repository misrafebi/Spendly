<!DOCTYPE html>
<html>
<head>
    <style>
         * { margin: 0; padding: 0; box-sizing: border-box; }
body {
  font-family: 'Segoe UI', Arial, sans-serif;
  background: #eef1f5;
  width: 1200px;
}
.wf-box {
  border: 1.5px dashed #9aa3af;
  background: #ffffff;
}
        .page-title {
  font-size: 22px;
  font-weight: 700;
  color: #2d3e50;
  margin-bottom: 4px;
}
.card {
  background: #fff;
  border: 1px solid #e2e6ec;
  border-radius: 6px;
  padding: 18px;
}

table { width: 100%; border-collapse: collapse; font-size: 13px; }
th {
  text-align: left;
  background: #f1f3f6;
  padding: 10px 12px;
  color: #5a6472;
  font-weight: 600;
  border-bottom: 1px solid #e2e6ec;
}
td {
  padding: 10px 12px;
  border-bottom: 1px solid #eef0f3;
  color: #3a4453;
}
.btn {
  display: inline-block;
  padding: 9px 18px;
  border-radius: 5px;
  font-size: 13px;
  font-weight: 600;
  text-align: center;
  cursor: pointer;
}
.btn-primary { background: #2d6cdf; color: #fff; }
.btn-secondary { background: #fff; color: #2d3e50; border: 1px solid #d6dbe3; }
.btn-danger { background: #fdeaea; color: #d64545; }
.btn-sm { padding: 5px 12px; font-size: 12px; }

    </style>
</head>
<%- include('../partials/user/navbar') %>
<%- include('../partials/user/sidebar') %>
            <div class="main" style="position:relative;">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <div>
                        <div class="page-title">My Categories</div>
                    </div>
                    <div class="btn btn-primary">+ Add Category</div>
                </div>

                <div style="display:flex;gap:16px;margin-top:20px;">
                    <div class="card" style="flex:1;">
                        <div style="font-size:13px;font-weight:700;color:#2f9e5e;margin-bottom:10px;">INCOME CATEGORIES
                        </div> 
                        <table>
                            <tr>
                                <td>Salary</td>
                                <td style="text-align:right;"><span style="color:#2d6cdf;">Edit</span> &nbsp; <span
                                        style="color:#d64545;">Delete</span></td>
                            </tr>
                            <tr>
                                <td>Freelance</td>
                                <td style="text-align:right;"><span style="color:#2d6cdf;">Edit</span> &nbsp; <span
                                        style="color:#d64545;">Delete</span></td>
                            </tr>
                            <tr>
                                <td>Investment Returns</td>
                                <td style="text-align:right;"><span style="color:#2d6cdf;">Edit</span> &nbsp; <span
                                        style="color:#d64545;">Delete</span></td>
                            </tr>
                        </table>
                    </div>
                    <div class="card" style="flex:1;">
                        <div style="font-size:13px;font-weight:700;color:#d64545;margin-bottom:10px;">EXPENSE CATEGORIES
                        </div>
                        <table>
                            <tr>
                                <td>Groceries</td>
                                <td style="text-align:right;"><span style="color:#2d6cdf;">Edit</span> &nbsp; <span
                                        style="color:#d64545;">Delete</span></td>
                            </tr>
                            <tr>
                                <td>Rent</td>
                                <td style="text-align:right;"><span style="color:#2d6cdf;">Edit</span> &nbsp; <span
                                        style="color:#d64545;">Delete</span></td>
                            </tr>
                            <tr>
                                <td>Electricity</td>
                                <td style="text-align:right;"><span style="color:#2d6cdf;">Edit</span> &nbsp; <span
                                        style="color:#d64545;">Delete</span></td>
                            </tr>
                            <tr>
                                <td>Petrol</td>
                                <td style="text-align:right;"><span style="color:#2d6cdf;">Edit</span> &nbsp; <span
                                        style="color:#d64545;">Delete</span></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</body>

</html>