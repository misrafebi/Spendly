<!DOCTYPE html>
<html>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

<head>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #eef1f5;
            width: 1200px;
        }

        .wf-box {
            border: 1.5px dashed #9aa3af;
            background: #ffffff;
        }

        .page-title {
            font-size: 22px;
            font-weight: 700;
            color: #2d3e50;
            margin-bottom: 4px;
        }

        .card {
            background: #fff;
            border: 1px solid #e2e6ec;
            border-radius: 6px;
            padding: 18px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        th {
            text-align: left;
            background: #f1f3f6;
            padding: 10px 12px;
            color: #5a6472;
            font-weight: 600;
            border-bottom: 1px solid #e2e6ec;
        }

        td {
            padding: 10px 12px;
            border-bottom: 1px solid #eef0f3;
            color: #3a4453;
        }

        .btn {
            display: inline-block;
            padding: 9px 18px;
            border-radius: 5px;
            font-size: 13px;
            font-weight: 600;
            text-align: center;
            cursor: pointer;
        }

        .btn-primary {
            background: #2d6cdf;
            color: #fff;
        }

        .btn-secondary {
            background: #fff;
            color: #2d3e50;
            border: 1px solid #d6dbe3;
        }

        .btn-danger {
            background: #fdeaea;
            color: #d64545;
        }

        .btn-sm {
            padding: 5px 12px;
            font-size: 12px;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.45);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-box {
            background: #fff;
            width: 380px;
            max-width: 90%;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .modal-title {
            font-size: 16px;
            font-weight: 700;
        }

        .modal-close {
            cursor: pointer;
            font-size: 20px;
            color: #888;
            line-height: 1;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .form-group input[type="text"] {
            width: 100%;
            padding: 8px 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
            box-sizing: border-box;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
        }

        .btn-secondary {
            background: #f1f1f1;
            color: #333;
        }
    </style>
</head>

<%- include('../partials/user/navbar') %>
    <%- include('../partials/user/sidebar') %>
        <div class="main" style="position:relative;">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div class="page-title">My Categories</div>
                </div>
                <div class="btn btn-primary" id="openAddCategoryBtn">+ Add Category</div>
            </div>

            <div style="display:flex;gap:16px;margin-top:20px;">

                <div class="card" style="flex:1;">
                    <div style="font-size:13px;font-weight:700;color:#2f9e5e;margin-bottom:10px;">INCOME CATEGORIES
                    </div>
                    <table>
                        <%categories.filter(cat=> cat.type==='income').forEach(cat=>{%>
                            <tr>
                                <td>
                                    <%=cat.name%>
                                </td>
                                <td style="text-align:right;"><span style="color:#2d6cdf;" data-id="<%=cat._id%>"
                                        data-name="<%=cat.name%>" data-type="<%=cat.type%>" class="edit-cat">Edit</span>
                                    &nbsp;
                                    <span style="color:#d64545;" data-id="<%=cat._id%>" class="delete-cat">Delete</span>
                                </td>
                            </tr>
                            <%})%>
                    </table>
                </div>


                <div class="card" style="flex:1;">
                    <div style="font-size:13px;font-weight:700;color:#d64545;margin-bottom:10px;">EXPENSE CATEGORIES
                    </div>
                    <table>
                        <%categories.filter(cat=> cat.type==='expense').forEach(cat=>{%>
                            <tr>
                                <td>
                                    <%=cat.name%>
                                </td>
                                <td style="text-align:right;"><span style="color:#2d6cdf;" data-id="<%=cat._id%>"
                                        data-name="<%=cat.name%>" data-type="<%=cat.type%>" class="edit-cat">Edit</span>
                                    &nbsp;
                                    <span style="color:#d64545;" data-id="<%=cat._id%>" class="delete-cat">Delete</span>
                                </td>
                            </tr>
                            <%})%>  
                    </table>

                </div>
            </div>
        </div>

        <!-- -------- DELETE CATEGORY --------- -->
        <script>
            const deleteBtns = document.querySelectorAll('.delete-cat')
            deleteBtns.forEach((btn) => {
                btn.addEventListener('click', () => deleteCat(btn))
            })

            function deleteCat(btn) {
                let currentId = btn.dataset.id

                if (!confirm(`Delete this category?`)) return

                fetch(`/user/category/delete/${currentId}`, {   
                    method: 'DELETE'
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            btn.closest('tr').remove()
                        } else {
                            alert(data.message || 'Error deleting category.')
                        }
                    })
                    .catch(error => {
                        console.error(error);
                        alert('Failed to delete category.');
                    })
            }
        </script>
        <!-- ------------- -->


        <!-- ---------- ADD CATEGORY MODAL ---------- -->
        <div id="addCategoryOverlay" class="modal-overlay">
            <div class="modal-box">
                <div class="modal-header">
                    <div class="modal-title">Add Category</div>
                    <span id="closeAddCategoryBtn" class="modal-close">&times;</span>
                </div>

                <form id="addCategoryForm" action="/user/category/add" method="POST">
                    <div class="form-group">
                        <label for="categoryName">Category Name</label>
                        <input type="text" id="categoryName" name="categoryName" />
                        <div class="text-danger" id="nameError"></div>
                    </div>

                    <div class="form-group">
                        <label>Type</label>
                        <div style="display:flex;gap:20px;margin-top:6px;">
                            <label style="font-weight:400;display:flex;align-items:center;gap:6px;">
                                <input type="radio" name="categoryType" value="income" id="incomeRadioBtn" /> Income
                            </label>
                            <label style="font-weight:400;display:flex;align-items:center;gap:6px;">
                                <input type="radio" name="categoryType" value="expense" id="expenseRadioBtn" /> Expense
                            </label>
                        </div>
                        <div class="text-danger" id="radioBtnError"></div>
                    </div>

                    <div class="modal-actions">
                        <div class="btn btn-secondary" id="cancelAddCategoryBtn">Cancel</div>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
        <!-- --------------- -->

        <!-- -------- EDIT CATEGORY MODAL --------- -->
        <div id="editCategoryOverlay" class="modal-overlay">
            <div class="modal-box">
                <div class="modal-header">
                    <div class="modal-title">EDIT CATEGORY</div>
                    <span id="closeEditCategoryBtn">&times;</span>
                </div>

                <form id="editCategoryForm">
                    <div class="form-group">
                        <label for="editCategoryName">Category Name</label>
                        <input type="text" name="editCategoryName" id="editCategoryName">
                        <div class="text-danger" id="edit-cat-name-error"></div>
                    </div>

                    <div class="form-group">
                        <label for="">Type</label>
                        <div style="display:flex;gap:20px;margin-top:6px;">
                            <label for="" style="font-weight:400;display:flex;align-items:center;gap:6px;">
                                <input type="radio" name="editCategoryType" id="edit-incomeRadioBtn" value="income">
                                Income
                            </label>
                            <label for="" style="font-weight:400;display:flex;align-items:center;gap:6px;">
                                <input type="radio" name="editCategoryType" id="edit-expenseRadioBtn" value="expense">
                                Expense
                            </label>
                        </div>
                        <div class="text-danger" id="edit-cat-type-error"></div>
                    </div>

                    <div class="modal-actions">
                        <div class="btn btn-secondary" id="cancelEditCategoryBtn">Cancel</div>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
        <!-- ------------- -->

        </div>
        </div>


        <!-- ------- ADD CATEGORY --------- -->
        <script>
            const openBtn = document.getElementById('openAddCategoryBtn');
            const closeBtn = document.getElementById('closeAddCategoryBtn');
            const cancelBtn = document.getElementById('cancelAddCategoryBtn');
            const overlay = document.getElementById('addCategoryOverlay');
            const form = document.getElementById('addCategoryForm');

            function openModal() {
                overlay.classList.add('active');
            }
            function closeModal() {
                overlay.classList.remove('active');
                form.reset();
            }
            openBtn.addEventListener('click', openModal);
            closeBtn.addEventListener('click', closeModal);
            cancelBtn.addEventListener('click', closeModal);

            // close when clicking outside the box
            overlay.addEventListener('click', (e) => {
                if (e.target === overlay) closeModal();
            });
            // if click modal-box e.target===overlay is false
            // if click background of modal-box e.target===overlay is true therefor closeModal() runs

            form.addEventListener('submit', async function (e) {

                const formData = new FormData(form); // create new object from form
                const payload = {
                    name: formData.get('categoryName'), // access date
                    type: formData.get('categoryType')
                };

                try {
                    const res = await fetch('/user/category/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)  // strigfy the object into JSON format
                    });
                    const data = await res.json(); //JSON -> JS Object:[ covert server's reponse into object (server sends response in json format , it convert into js object)]

                    if (data.success) {
                        return location.reload(); // simplest way to refresh the lists
                    } else {
                        alert(data.message || 'Something went wrong');
                    }
                } catch (err) {
                    console.error(err);
                    alert('Failed to add category');
                }
            });
        </script>

        <!-- ----- EDIT CATEGORY ------ -->
        <script>
            const editOpenBtn = document.querySelectorAll('.edit-cat');
            const editCloseBtn = document.getElementById('closeEditCategoryBtn')
            const editCancelBtn = document.getElementById('cancelEditCategoryBtn')
            const editOverlay = document.getElementById('editCategoryOverlay')
            const editForm = document.getElementById('editCategoryForm')

            const editNameInput = document.getElementById('editCategoryName');
            const editIncomeRadio = document.getElementById('edit-incomeRadioBtn');
            const editExpenseRadio = document.getElementById('edit-expenseRadioBtn');
            const nameError = document.getElementById('edit-cat-name-error');
            const typeError = document.getElementById('edit-cat-type-error')

            let currentEditId = null

            editOpenBtn.forEach(btn => {
                btn.addEventListener('click', () => openModal(btn));
            })

            // editOpenBtn.addEventListener('click', openModal)
            editCloseBtn.addEventListener('click', closeModal)
            editCancelBtn.addEventListener('click', closeModal)

            function openModal(btn) {
                currentEditId = btn.dataset.id
                editNameInput.value = btn.dataset.name
                editIncomeRadio.checked = btn.dataset.type === 'income'
                editExpenseRadio.checked = btn.dataset.type === 'expense'
                editOverlay.classList.add('active');
            }
            function closeModal() {
                editOverlay.classList.remove('active');
                editForm.reset();
                currentEditId = null
            }

            editOverlay.addEventListener('click', (e) => {
                if (e.target === editOverlay) closeModal()
            })

            editForm.addEventListener('submit', async function (e) {

                if (!currentEditId) {
                    alert('No category selected for editing.')
                    return
                }

                const formData = new FormData(editForm)

                const payload = {
                    name: formData.get('editCategoryName'),
                    type: formData.get('editCategoryType')
                }

                try {
                    const res = await fetch(`/user/category/edit/${currentEditId}`, {
                        method: 'PATCH',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    })

                    const data = res.json()

                    if (data.success) {
                        return location.reload()
                    } else {
                        return alert(data.message || 'Something went wrong')
                    }
                } catch (error) {
                    console.error(err);
                    alert('Failed to add category');
                }
            })
        </script>


        <!-- ------ ADD CATEGORY FRONT END VALIDATION ------ -->
        <script>
            const addForm = document.getElementById('addCategoryForm')

            function addFormValidation(isValid) {
                const name = document.getElementById('categoryName')
                const incomeBtn = document.getElementById('incomeRadioBtn')
                const expenseBtn = document.getElementById('expenseRadioBtn')

                const nameError = document.getElementById('nameError')
                const radioButtonError = document.getElementById('radioBtnError')

                const nameVal = name.value

                if (!nameVal) {
                    nameError.textContent = 'Name is requiered'
                    isValid = false
                } else if (!incomeBtn.checked && !expenseBtn.checked) {
                    radioButtonError.textContent = 'Type field is requiered'
                    isValid = false
                } else {
                    nameError.textContent = ''
                    radioButtonError.textContent = ''
                    isValid = true
                }
                return isValid
            }

            addForm.addEventListener('submit', function (event) {
                event.preventDefault()

                let isValid = true

                isValid = addFormValidation(isValid)
                if (isValid) {
                    addForm.submit()
                }
            })
        </script>

        <!-- ------- EDIT CATEGORY FRONT-END VALIDATION ------ -->
        <script>
            const editform = document.getElementById('editCategoryForm')

            function editFormValidation(isValid) {
                const editCatName = document.getElementById('editCategoryName')
                const editIncRadioBtn = document.getElementById('edit-incomeRadioBtn')
                const editExpRadioBtn = document.getElementById('edit-expenseRadioBtn')

                const editNameVal = editCatName.value

                const editNameError = document.getElementById('edit-cat-name-error')
                const editRadioError = document.getElementById('edit-cat-type-error')

                if (!editNameVal) {
                    editNameError.textContent = 'Name field required.'
                    isValid = false
                } else if (!editIncRadioBtn.checked && !editExpRadioBtn.checked) {
                    editRadioError.textContent = 'Type field requiered.'
                    isValid = false
                } else {
                    editNameError.textContent = ''
                    editRadioError.textContent = ''
                    isValid = true
                }
                return isValid
            }

            editForm.addEventListener('submit', function (e) {
                e.preventDefault()

                let isValid = true
                isValid = editFormValidation(isValid)

                if (isValid) {
                    editform.submit()
                }
            })
        </script>

        <!-- ------ MESSAGE ------ -->
        <script>
            const urlParams = new URLSearchParams(window.location.search)
            const message = urlParams.get('message')

            if (message) {
                alert(message)
            }
        </script>


        <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
        </body>

</html>