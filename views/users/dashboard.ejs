<!DOCTYPE html>
<html>

<head>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #eef1f5;
            width: 1200px;
        }

        .wf-box {
            border: 1.5px dashed #9aa3af;
            background: #ffffff;
        }

        .page-title {
            font-size: 22px;
            font-weight: 700;
            color: #2d3e50;
            margin-bottom: 4px;
        }

        .card {
            background: #fff;
            border: 1px solid #e2e6ec;
            border-radius: 6px;
            padding: 18px;
        }

        .card {
            background: #fff;
            border: 1px solid #e2e6ec;
            border-radius: 6px;
            padding: 18px;
        }

        .stat-row {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
        }

        .stat-card {
            flex: 1;
            background: #fff;
            border: 1px solid #e2e6ec;
            border-radius: 6px;
            padding: 16px 18px;
        }

        .stat-card .label {
            font-size: 12px;
            color: #8a94a3;
            margin-bottom: 6px;
        }

        .stat-card .value {
            font-size: 24px;
            font-weight: 700;
            color: #2d3e50;
        }

        .stat-card.income .value {
            color: #2f9e5e;
        }

        .stat-card.expense .value {
            color: #d64545;
        }

        .stat-card.balance .value {
            color: #2d6cdf;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        th {
            text-align: left;
            background: #f1f3f6;
            padding: 10px 12px;
            color: #5a6472;
            font-weight: 600;
            border-bottom: 1px solid #e2e6ec;
        }

        td {
            padding: 10px 12px;
            border-bottom: 1px solid #eef0f3;
            color: #3a4453;
        }
    </style>
</head>

<body>

    <%- include('../partials/user/navbar') %>
        <%- include('../partials/user/sidebar') %>
            <div class="main" style="position:relative;">
                <div class="page-title">Dashboard</div>


                <div class="stat-row">
                    <div class="stat-card income">
                        <div class="label">Total Income</div>
                        <span class="value" id="totalIncome">₹0</span>
                    </div>
                    <div class="stat-card expense">
                        <div class="label">Total Expense</div>
                        <span class="value" id="totalExpense">₹0</span>
                    </div>
                    <div class="stat-card balance">
                        <div class="label">Balance</div>
                        <span class="value" id="totalBalance">₹0</span>
                    </div>
                </div>

                <div style="display:flex;gap:16px;">
                    <div class="card wf-box"
                        style="flex:1.3;height:270px;display:flex;align-items:center;justify-content:center;position:relative;">
                        <div class="label-tag">Overview of this month </div>
                        <div style="position:relative;width:100%;height:220px;">
                            <canvas id="expenseChart"></canvas>
                        </div>
                       
                        <svg width="200" height="200" viewBox="0 0 42 42">
                            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#eee" stroke-width="8"></circle>
                            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#2d6cdf" stroke-width="8"
                                stroke-dasharray="35 65" stroke-dashoffset="25"></circle>
                            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#6fcf97" stroke-width="8"
                                stroke-dasharray="25 75" stroke-dashoffset="-10"></circle>
                            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#f2b84b" stroke-width="8"
                                stroke-dasharray="20 80" stroke-dashoffset="-35"></circle>
                            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#d64545" stroke-width="8"
                                stroke-dasharray="20 80" stroke-dashoffset="-55"></circle>
                        </svg>
                    </div>

                     <script>
                            fetch('/user/dashboard/category-summary')
                                .then(res => res.json())
                                .then(data => {
                                    const ctx = document.getElementById('expenseChart').getContext('2d')
                                    if (data.labels.length === 0) {
                                        // no expenses yet this month — skip drawing, or show a placeholder message
                                        return
                                    }

                                    new Chart(ctx, {
                                        type: 'doughnut',
                                        data: {
                                            labels: data.labels,
                                            dataset: [{
                                                data: data.values,
                                                backgroundColor: [
                                                    '#2d6cdf', '#6fcf97', '#f2b84b', '#d64545',
                                                    '#af7aa1', '#59a14f', '#edc949', '#4e79a7'
                                                ],
                                                borderWidth: 2
                                            }]
                                        },
                                        options: {
                                            responsive: true,
                                            maintainAspectRatio: false,
                                            plugins: {
                                                legend: {
                                                    position: 'bottom',
                                                    labels: { boxWidth: 12, font: { size: 11 } }
                                                }
                                            }
                                        }
                                    })
                                })
                        </script>
                        
                    <div class="card wf-box" style="flex:1;height:270px;position:relative;padding-top:26px;">
                        <div class="label-tag">Recent Transactions</div>
                        <table>
                            <%recent.forEach(t=>{%>
                                <tr>
                                    <td>
                                        <%=t.category.name%>
                                    </td>
                                    <td style="text-align:right;color:#d64545;">-₹<%=t.amount%>
                                    </td>
                                </tr>
                                <%})%>
                        </table>
                    </div>
                </div>
            </div>
            </div>

            </div>

            <script>
                fetch('/user/dashboard/monthly-summary')
                    .then(res => res.json())
                    .then(data => {
                        document.getElementById('totalIncome').textContent = '₹' + data.income
                        document.getElementById('totalExpense').textContent = '₹' + data.expense
                        document.getElementById('totalBalance').textContent = '₹' + data.balance
                    })
            </script>

            <script>
                const urlParams = new URLSearchParams(window.location.search)
                const message = urlParams.get('message')

                if (message) {
                    alert(message)
                }
            </script>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
</body>

</html>