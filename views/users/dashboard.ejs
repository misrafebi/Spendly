<!DOCTYPE html>
<html>

<head>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #eef1f5;
            width: 1200px;
        }

        .wf-box {
            border: 1.5px dashed #9aa3af;
            background: #ffffff;
        }

        .page-title {
            font-size: 22px;
            font-weight: 700;
            color: #2d3e50;
            margin-bottom: 4px;
        }

        .card {
            background: #fff;
            border: 1px solid #e2e6ec;
            border-radius: 6px;
            padding: 18px;
        }

        .card {
            background: #fff;
            border: 1px solid #e2e6ec;
            border-radius: 6px;
            padding: 18px;
        }

        .stat-row {
            display: flex;
            gap: 16px;
            margin-bottom: 20px;
        }

        .stat-card {
            flex: 1;
            background: #fff;
            border: 1px solid #e2e6ec;
            border-radius: 6px;
            padding: 16px 18px;
        }

        .stat-card .label {
            font-size: 12px;
            color: #8a94a3;
            margin-bottom: 6px;
        }

        .stat-card .value {
            font-size: 24px;
            font-weight: 700;
            color: #2d3e50;
        }

        .stat-card.income .value {
            color: #2f9e5e;
        }

        .stat-card.expense .value {
            color: #d64545;
        }

        .stat-card.balance .value {
            color: #2d6cdf;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        th {
            text-align: left;
            background: #f1f3f6;
            padding: 10px 12px;
            color: #5a6472;
            font-weight: 600;
            border-bottom: 1px solid #e2e6ec;
        }

        td {
            padding: 10px 12px;
            border-bottom: 1px solid #eef0f3;
            color: #3a4453;
        }
    </style>
</head>

<body>

    <%- include('../partials/user/navbar') %>
        <%- include('../partials/user/sidebar') %>
            <div class="main" style="position:relative;">
                <div class="page-title">Dashboard</div>


                <div class="stat-row">
                    <div class="stat-card income">
                        <div class="label">Total Income</div>
                        <div class="value">₹42,000</div>
                    </div>
                    <div class="stat-card expense">
                        <div class="label">Total Expense</div>
                        <div class="value">₹27,450</div>
                    </div>
                    <div class="stat-card balance">
                        <div class="label">Balance</div>
                        <div class="value">₹14,550</div>
                    </div>
                </div>

                <div style="display:flex;gap:16px;">
                    <div class="card wf-box"
                        style="flex:1.3;height:270px;display:flex;align-items:center;justify-content:center;position:relative;">
                        <div class="label-tag">Overview of this month — July 2026</div>
                        <svg width="200" height="200" viewBox="0 0 42 42">
                            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#eee" stroke-width="8"></circle>
                            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#2d6cdf" stroke-width="8"
                                stroke-dasharray="35 65" stroke-dashoffset="25"></circle>
                            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#6fcf97" stroke-width="8"
                                stroke-dasharray="25 75" stroke-dashoffset="-10"></circle>
                            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#f2b84b" stroke-width="8"
                                stroke-dasharray="20 80" stroke-dashoffset="-35"></circle>
                            <circle cx="21" cy="21" r="15.9" fill="transparent" stroke="#d64545" stroke-width="8"
                                stroke-dasharray="20 80" stroke-dashoffset="-55"></circle>
                        </svg>
                    </div>
                    <div class="card wf-box" style="flex:1;height:270px;position:relative;padding-top:26px;">
                        <div class="label-tag">Recent Transactions</div>
                        <table>
                            <tr>
                                <td>Groceries</td>
                                <td style="text-align:right;color:#d64545;">-₹1,200</td>
                            </tr>
                            <tr>
                                <td>Salary</td>
                                <td style="text-align:right;color:#2f9e5e;">+₹42,000</td>
                            </tr>
                            <tr>
                                <td>Electricity</td>
                                <td style="text-align:right;color:#d64545;">-₹950</td>
                            </tr>
                            <tr>
                                <td>Petrol</td>
                                <td style="text-align:right;color:#d64545;">-₹800</td>
                            </tr>
                            <tr>
                                <td>Internet</td>
                                <td style="text-align:right;color:#d64545;">-₹699</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            </div>

            </div>

            <script>
                const urlParams = new URLSearchParams(window.location.search)
                const message = urlParams.get('message')

                if (message) {
                    alert(message)
                }
            </script>
</body>

</html>