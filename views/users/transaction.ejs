      <!-- ----- MESSAGE ----- -->
      <script>
        const urlParams = new URLSearchParams(window.location.search)
        const message = urlParams.get('message')

        if (message) {
          alert(message)
        }
      </script>
      <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

</body>

</html>