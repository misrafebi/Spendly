<!DOCTYPE html>
<html>

<head>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap"
    rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
      background: #f4f5f7;
      width: 1200px;
      color: #1f2937;
    }

    .page-title {
      font-size: 22px;
      font-weight: 700;
      color: #16202e;
      margin-bottom: 4px;
      letter-spacing: -0.01em;
    }

    .page-sub {
      font-size: 13px;
      color: #7c8798;
    }

    /* ---------- Entry bar ---------- */

    .entry-bar {
      background: #ffffff;
      border: 1px solid #e3e6eb;
      border-radius: 10px;
      padding: 14px 16px;
      margin: 18px 0 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 1px 2px rgba(16, 24, 40, 0.03);
    }

    .type-toggle {
      display: inline-flex;
      border: 1px solid #dfe3ea;
      border-radius: 8px;
      overflow: hidden;
      flex-shrink: 0;
      font-size: 12.5px;
      font-weight: 600;
    }

    .type-toggle button {
      appearance: none;
      border: none;
      background: #fff;
      color: #8a94a3;
      padding: 9px 16px;
      cursor: pointer;
      transition: background 0.15s ease, color 0.15s ease;
    }

    .type-toggle button.active[data-type="income"] {
      background: #e3f7ea;
      color: #1c8a4c;
    }

    .type-toggle button.active[data-type="expense"] {
      background: #fbe6e6;
      color: #c53030;
    }

    .entry-bar input,
    .entry-bar select {
      font-family: inherit;
      border: 1px solid #dfe3ea;
      border-radius: 7px;
      padding: 9px 11px;
      font-size: 13px;
      color: #16202e;
      background: #fbfbfc;
    }

    .entry-bar input::placeholder {
      color: #a2abb8;
    }

    .entry-bar input:focus,
    .entry-bar select:focus {
      outline: none;
      border-color: #3b5bdb;
      background: #fff;
      box-shadow: 0 0 0 3px rgba(59, 91, 219, 0.12);
    }

    #amount {
      width: 120px;
      font-family: 'IBM Plex Mono', monospace;
    }

    #category {
      width: 160px;
    }

    #date {
      width: 148px;
      color: #16202e;
    }

    #note {
      flex: 1;
      min-width: 160px;
    }

    .field-error {
      font-size: 11px;
      color: #d64545;
      position: absolute;
      margin-top: 42px;
    }

    .btn-save {
      appearance: none;
      border: none;
      background: #2d6cdf;
      color: #fff;
      font-weight: 600;
      font-size: 13px;
      padding: 10px 20px;
      border-radius: 7px;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.15s ease;
    }

    .btn-save:hover {
      background: #2558b8;
    }

    /* ---------- Table ---------- */

    .card {
      background: #fff;
      border: 1px solid #e3e6eb;
      border-radius: 10px;
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    th {
      text-align: left;
      background: #f7f8fa;
      padding: 11px 16px;
      color: #6b7684;
      font-weight: 600;
      font-size: 11.5px;
      border-bottom: 1px solid #e3e6eb;
    }

    td {
      padding: 12px 16px;
      border-bottom: 1px solid #eef0f3;
      color: #313d4d;
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background: #fafbfc;
    }

    .amount-cell {
      text-align: right;
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 600;
    }

    .amount-cell.income {
      color: #1c8a4c;
    }

    .amount-cell.expense {
      color: #c53030;
    }

    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
    }

    .badge.income {
      background: #e3f7ea;
      color: #1c8a4c;
    }

    .badge.expense {
      background: #fbe6e6;
      color: #c53030;
    }

    .row-actions span {
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
    }

    .row-actions .edit {
      color: #2d6cdf;
    }

    .row-actions .delete {
      color: #d64545;
      margin-left: 12px;
    }
  </style>
</head>

<body>
  <%- include('../partials/user/navbar') %>
    <%- include('../partials/user/sidebar') %>
      <div class="main">
        <div class="page-title">Transactions</div>
        <div class="page-sub">Log income and expenses, and keep your ledger up to date.</div>

        <form action="/user/transaction/add" method="post" id="add-form">
          <input type="hidden" name="type" id="type-input" value="expense">

          <div class="entry-bar">
            <div class="type-toggle" id="type-toggle">
              <button type="button" data-type="income" id="income-type">Income</button>
              <button type="button" data-type="expense" class="active" id="expense-type">Expense</button>
              <!-- <input type="hidden" name="type" id="type-input"> -->
            </div>

            <div style="position:relative;">
              <input type="text" placeholder="Amount" name="amount" id="amount">
              <div class="field-error" id="amount-error"></div>
            </div>

            <div style="position:relative;">
              <select name="category" id="category">
                <option value="" disabled selected>Category</option>
                <%categories.forEach(cat=>{%>
                  <option value="<%=cat._id%>">
                    <%=cat.name%>
                  </option>
                  <%})%>
              </select>
              <div class="field-error" id="category-error"></div>
            </div>

            <div style="position:relative;">
              <input class="form-input" placeholder="Date" name="date" id="date" type="date">
              <div class="field-error" id="date-error"></div>
            </div>

            <input placeholder="Note (optional)" type="text" name="note" id="note">

            <button class="btn-save" type="submit">Save</button>
          </div>
        </form>




        <div class="card">
          <table>

            <tr>
              <th>Date</th>
              <th>Category</th>
              <th>Note</th>
              <th>Type</th>
              <th style="text-align:right;">Amount</th>
              <th>Actions</th>
            </tr>

            <%transactions.forEach(tnstn=>{%>
              <tr>
                <td>
                  <%=tnstn.date.toLocaleString('en-US', { month: 'short' , day: 'numeric' , year: 'numeric' })%>
                </td>
                <td>
                  <%=tnstn.category? tnstn.category.name:'Uncategorized'%>
                </td>
                <%if(!tnstn.note){%>
                  <td>—</td>
                  <%}else{%>
                    <td>
                      <%=tnstn.note%>
                    </td>
                    <%}%>
                      <%if(tnstn.type==='income'){%>
                        <td><span class="badge income">Income</span></td>
                        <%}else{%>
                          <td><span class="badge expense">Expense</span></td>
                          <%}%>
                            <%if(tnstn.type==='income'){%>
                              <td class="amount-cell income">+₹<%=tnstn.amount%>
                              </td>
                              <%}else{%>
                                <td class="amount-cell expense">-₹<%=tnstn.amount%>
                                </td>
                                <%}%>
                                  <td class="row-actions"><span class="edit">Edit</span><span
                                      class="delete">Delete</span>
                                  </td>
              </tr>
              <%})%>

          </table>
        </div>
      </div>

      <!-- ----- SELECT INCOME AND EXPENSE ------ -->
      <script>
        const incomeType = document.getElementById('income-type')
        const expenseType = document.getElementById("expense-type")
        const type = document.getElementById("type-input")
        const addForm = document.getElementById('add-form')
        function setType(selectedBtn, otherBtn, value) {
          selectedBtn.classList.add('active');
          otherBtn.classList.remove('active');
          type.value = value;
        }

        incomeType.addEventListener('click', () => setType(incomeType, expenseType, 'income'));
        expenseType.addEventListener('click', () => setType(expenseType, incomeType, 'expense'));
      </script>
      <!-- ----- TOGGLE ------ -->
      <script>
        const typeToggle = document.getElementById('type-toggle')
        const typeInput = document.getElementById('type-input')

        typeToggle.addEventListener('click', function (e) {
          const btn = e.target.closest('button[data-type]')
          if (!btn) return
          typeToggle.querySelectorAll('button').forEach(b => b.classList.remove('active'))
          btn.classList.add('active')
          typeInput.value = btn.dataset.type
        })
      </script>


