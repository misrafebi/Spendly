<!DOCTYPE html>
<html>

<head>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      background: #eef1f5;
      width: 1200px;
    }

    .wf-box {
      border: 1.5px dashed #9aa3af;
      background: #ffffff;
    }

    .page-title {
      font-size: 22px;
      font-weight: 700;
      color: #2d3e50;
      margin-bottom: 4px;
    }

    .card {
      background: #fff;
      border: 1px solid #e2e6ec;
      border-radius: 6px;
      padding: 18px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-label {
      font-size: 13px;
      font-weight: 600;
      color: #3a4453;
      margin-bottom: 6px;
      display: block;
    }

    .form-input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #d6dbe3;
      border-radius: 5px;
      font-size: 13px;
      color: #8a94a3;
      background: #fff;
    }

    .btn {
      display: inline-block;
      padding: 9px 18px;
      border-radius: 5px;
      font-size: 13px;
      font-weight: 600;
      text-align: center;
      cursor: pointer;
      border: #2d6cdf;
    }

    .btn-primary {
      background: #2d6cdf;
      color: #fff;
    }

    .btn-secondary {
      background: #fff;
      color: #2d3e50;
      border: 1px solid #d6dbe3;
    }

    .btn-danger {
      background: #fdeaea;
      color: #d64545;
    }

    .btn-sm {
      padding: 5px 12px;
      font-size: 12px;
    }
  </style>
</head>

<body>
  <%- include('../partials/user/navbar') %>
    <%- include('../partials/user/sidebar') %>
      <div class="main" style="position:relative;">
        <div class="page-title">Change Password</div>
        <br>
        <div class="card wf-box" style="max-width:420px;padding:24px;">

          <form action="/user/change-password" method="post" id="change-password-form">

            <div class="form-group">
              <span class="form-label">Current Password</span>
              <input type="password" class="form-input" name="currentPassword" id="current-password">
              <div class="text-danger" id="current-password-error"></div>
            </div>
            <div class="form-group">
              <span class="form-label">New Password</span>
              <input type="password" class="form-input" name="newPassword" id="new-password">
              <div class="text-danger" id="new-password-error"></div>
            </div>
            <div class="form-group">
              <span class="form-label">Confirm New Password</span>
              <input type="password" class="form-input" name="confirmNewPassword" id="confirm-new-password">
              <div class="text-danger" id="confirm-new-password-error"></div>
            </div>
            <button type="submit" class="btn btn-primary">Update Password</button>

          </form>

        </div>
      </div>
      </div>

      </div>

      <script>
        const form = document.getElementById('change-password-form')

        const currentPass = document.getElementById('current-password')
        const newPass = document.getElementById('new-password')
        const confirmPass = document.getElementById('confirm-new-password')

        const currentPassErr = document.getElementById('current-password-error')
        const newPassErr = document.getElementById('new-password-error')
        const confirmPassErr = document.getElementById('confirm-new-password-error')

        function passwordValidation(isValid) {
          const currentPassVal = currentPass.value.trim()
          const newPassVal = newPass.value.trim()
          const confirmPassVal = confirmPass.value.trim()

          const aplha = /[a-zA-Z]/
          const digit = /\d/

          if (!currentPassVal) {
            currentPassErr.textContent = 'Current password is required.'
            isValid = false
          } else if (!newPassVal) {
            newPassErr.textContent = 'New Password is required.'
            isValid = false
          } else if (!confirmPassVal) {
            confirmPassErr.textContent = 'Confirm Password is required.'
            isValid = false
          } else if (!aplha.test(newPassVal) || !digit.test(newPassVal)) {
            newPassErr.textContent = 'Password must contain at least one letter and one digit.'
            isValid = false
          } else if (!aplha.test(confirmPassVal) || !digit.test(confirmPassVal)) {
            confirmPassErr.textContent = 'Password must contain at least one letter and one digit.'
            isValid = false
          } else if (newPassVal.length < 8) {
            newPassErr.textContent = 'Password must be at least 8 characters long.'
            isValid = false
          } else if (confirmPassVal.length < 8) {
            confirmPassErr.textContent = 'Password must be at least 8 characters long.'
            isValid = false
          } else if (newPassVal !== confirmPassVal) {
            confirmPassErr.textContent = 'New password and confirm password must be same.'
            isValid = false
          } else {
            currentPassErr.textContent = ''
            newPassErr.textContent = ''
            confirmPassErr.textContent = ''
          }

          return isValid
        }

        form.addEventListener('submit', function (event) {
          event.preventDefault()

          let isValid = true

          isValid = passwordValidation(isValid)

          if (isValid) {
            form.submit()
          }
        })
      </script>

      <script>
        const urlParams=new URLSearchParams(window.location.search)
        const message=urlParams.get('message')

        if(message){
          alert(message)
        }
      </script>

      <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>

</html>